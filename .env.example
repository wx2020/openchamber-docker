# Required: choose a long, unique password before exposing OpenChamber.
OPENCHAMBER_UI_PASSWORD=replace-with-a-long-random-password

# Optional: pin a published image instead of using latest.
# OPENCHAMBER_IMAGE=ghcr.io/wx2020/openchamber-docker:1.18.1

# Optional settings. Uncomment these in docker-compose.yml or provide them
# through a compose override when you need tunnel or external OpenCode support.
# OPENCHAMBER_TUNNEL_PROVIDER=cloudflare
# OPENCHAMBER_TUNNEL_MODE=quick
# OPENCHAMBER_TUNNEL_HOSTNAME=app.example.com
# OPENCHAMBER_TUNNEL_TOKEN=replace-with-a-cloudflare-token
# OPENCODE_HOST=http://host.docker.internal:4096
# OPENCODE_SKIP_START=true
